import { Button, ScrollView, VerticalBox, HorizontalBox } from "std-widgets.slint";
import "../fonts/BabelStoneFlags.ttf";

export struct ServerConfig {
    name: string,
    flag: string,
    ping: string,
    speed: string,
    selected: bool,
    is_connected: bool,
}

component ServerItem inherits Rectangle {
    in property <string> name;
    in property <string> flag;
    in property <string> ping;
    in property <string> speed;
    in property <bool> is_selected;
    in property <bool> is_connected;
    callback selected();

    height: 52px;
    
    // Выделение фоном работает ВСЕГДА при клике (серый цвет)
    background: is_selected ? #3a3a3c : #1c1c1e;
    
    // Зеленая рамка показывает только активное подключение!
    border-radius: 8px;
    border-width: is_connected ? 2px : 0px;
    border-color: #30d158;

    animate background { duration: 150ms; }

    TouchArea { clicked => { root.selected(); } }

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        

        Text { 
            text: flag; 
            color: #30d158; 
            font-size: 18px; 
            width: 32px;
            vertical-alignment: center;
            horizontal-alignment: center;
            // horizontal-stretch: 1; 
            font-family: "BabelStone Flags";
        }
        Text { 
            text: name; 
            color: #ffffff; 
            font-size: 14px; 
            vertical-alignment: center;
            horizontal-stretch: 1; 
        }

        VerticalBox {
            alignment: center;
            spacing: 0px;
            Text { 
                text: is_connected ? "ПОДКЛЮЧЕНО" : ping; 
                color: is_connected ? #30d158 : #8e8e93; 
                font-size: 11px; 
                horizontal-alignment: right; 
                font-weight: is_connected ? 700 : 400;
            }
            
            Text { 
                text: speed; 
                color: #30d158; 
                font-size: 11px; 
                horizontal-alignment: right; 
            }
            
        }
    }
}

export component MainWindow inherits Window {
    title: "onlyprox";
    preferred-width: 960px;
    preferred-height: 700px;
    background: #121212;

    icon: @image-url("../assets/shield.svg");

    in-out property <bool> is_connected: false;
    in-out property <bool> is_searching: false;
    in-out property <float> search_progress: 0.0;
    in-out property <string> search_stage: "Поиск серверов...";

    in-out property <[ServerConfig]> configs: [];

    callback toggle_vpn();
    callback start_search();
    callback select_config(int);
    callback refresh_configs();

    HorizontalBox {
        padding: 20px;
        spacing: 20px;

        VerticalBox {
            width: 260px;
            alignment: space-between;

            HorizontalBox {
                alignment: center;
                Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 24px;
                    
                    background: power-ta.has-hover ? 
                        (root.is_connected ? #34e162 : #3a3a3c) : 
                        (root.is_connected ? #30d158 : #2c2c2e); 
                    
                    animate background { duration: 100ms; }

                    power-ta := TouchArea {
                        clicked => { root.toggle_vpn(); }
                    }

                    Image {
                        source: @image-url("../assets/power.svg");
                        width: 52px;
                        height: 52px;
                        image-fit: contain;
                        colorize: power-ta.has-hover ? #ffffff : #e0e0e0; 
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        animate colorize { duration: 100ms; }
                    }
                }
            }

            Rectangle {
                height: 50px;
                background: search_ta.has-hover ? #3a3a3c : #2c2c2e;
                border-radius: 12px;
                clip: true;
                
                animate background { duration: 100ms; }
                
                search_ta := TouchArea { 
                    clicked => { 
                        if (!root.is_searching) { root.start_search(); }
                    } 
                }
                
                if root.is_searching : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: #2c2c2e;
                }

                if root.is_searching : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * root.search_progress;
                    height: parent.height;
                    background: #0a84ff;
                }

                Text {
                    text: root.is_searching ? root.search_stage : "Поиск конфигураций";
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        Rectangle {
            background: #1c1c1e;
            border-radius: 14px;
            horizontal-stretch: 1;

            VerticalBox {
                padding: 16px;
                spacing: 12px;

                HorizontalBox {
                    Text {
                        text: "Конфигурации";
                        color: #ffffff;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 42px;
                        height: 42px;
                        border-radius: 21px;
                        background: ta.has-hover ? #3a3a3c : #2c2c2e;

                        animate background {
                            duration: 100ms;
                            easing: ease-in-out;
                        }

                        ta := TouchArea { 
                            clicked => { root.refresh_configs(); } 
                        }

                        Image {
                            source: @image-url("../assets/rotate-ccw.svg");
                            width: 24px;
                            height: 24px;
                            image-fit: contain;
                            colorize: ta.has-hover ? #ffffff : #bbbbbb; 
                            horizontal-alignment: center;
                            vertical-alignment: center;

                            animate colorize { duration: 100ms; }
                        }
                    }
                }

                ScrollView {
                    VerticalBox {
                        spacing: 0px;
                        for cfg[index] in root.configs : ServerItem {
                            flag: cfg.flag;
                            name: cfg.name;
                            ping: cfg.ping;
                            speed: cfg.speed;
                            is_selected: cfg.selected;
                            is_connected: cfg.is_connected;
                            selected => { root.select_config(index); }
                        }
                    }
                }
            }
        }
    }
}